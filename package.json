{
  "name": "devixus-router",
  "version": "0.1.0",
  "description": "A local AI proxy that automatically routes simple prompts to cheaper LLM models to save API costs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "devixus-router": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --enable-source-maps --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "ai",
    "llm",
    "proxy",
    "anthropic",
    "claude",
    "cost-saving",
    "router",
    "cli"
  ],
  "author": "Minhaz",
  "license": "MIT",
  "dependencies": {
    "cac": "^6.7.14",
    "chalk": "^5.4.1",
    "lowdb": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
